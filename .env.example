# Firebase web app config (Firebase console -> Project settings -> Your apps -> SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=pitpivo.cz
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FUNCTIONS_REGION=europe-west3
# 1 = use local emulators (firebase emulators:start)
VITE_USE_EMULATORS=0
# App Check (reCAPTCHA Enterprise site key, veřejný). Prázdné = vypnuto.
VITE_APPCHECK_SITE_KEY=
